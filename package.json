{
  "name": "foodtopia",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack --experimental-https",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:recipes": "tsx scripts/validate-recipes.ts",
    "validate:recipes:publication": "tsx scripts/validate-recipes.ts --publication",
    "generate:recipe-import": "tsx scripts/generate-recipe-import-sql.ts",
    "eval:vision": "tsx scripts/score-vision-eval.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm validate:recipes"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "inngest": "^4.18.0",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
