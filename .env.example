NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for older Supabase projects; leave unset when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only testing alias. Set the password directly in Supabase
# Auth; never place it in this file or in deployment environment variables.
FOODTOPIA_ADMIN_LOGIN_ENABLED=false
FOODTOPIA_ADMIN_USERNAME=
FOODTOPIA_ADMIN_EMAIL=
# Deployment-wide default model IDs shown as pre-fill hints. Households always
# supply their own provider API keys; the deployment never holds one.
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_RECIPE_MODEL=gpt-5.6-luna
# Default OpenRouter model IDs (provider/model format), editable per household
# in Settings alongside each household's own API key.
OPENROUTER_VISION_MODEL=
OPENROUTER_RECIPE_MODEL=
# Required for household BYO AI keys. Map key IDs to
# 32-byte base64 values; ACTIVE must name one entry. Never expose these values
# through NEXT_PUBLIC_* variables.
HOUSEHOLD_AI_CREDENTIAL_KEYRING={}
HOUSEHOLD_AI_CREDENTIAL_ACTIVE_KEY_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
