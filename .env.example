# Local demo mode is enabled automatically when the Supabase variables are absent.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional for `pnpm start` or a non-production preview without cloud services.
# This flag is ignored on a Vercel production deployment.
FOODTOPIA_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for older Supabase projects; leave unset when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only testing alias. Set the password directly in Supabase
# Auth; never place it in this file or in Vercel environment variables.
FOODTOPIA_ADMIN_LOGIN_ENABLED=false
FOODTOPIA_ADMIN_USERNAME=
FOODTOPIA_ADMIN_EMAIL=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_RECIPE_MODEL=gpt-5.6-luna
# Optional platform-managed OpenRouter route. Model IDs use OpenRouter's
# provider/model format and are also editable per household in Settings.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_RECIPE_MODEL=
# Required only when owners may store a household provider key. Map key IDs to
# 32-byte base64 values; ACTIVE must name one entry. Never expose these values
# through NEXT_PUBLIC_* variables.
HOUSEHOLD_AI_CREDENTIAL_KEYRING={}
HOUSEHOLD_AI_CREDENTIAL_ACTIVE_KEY_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
